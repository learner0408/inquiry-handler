APP_ENV=local
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/inquiry
WHATSAPP_VERIFY_TOKEN=any-random-string-you-choose
WHATSAPP_ACCESS_TOKEN=temporary-or-system-user-token
WHATSAPP_PHONE_ID=numeric-phone-number-id
WHATSAPP_APP_SECRET=from-app-settings-basic
GOOGLE_SERVICE_ACCOUNT_JSON=./secrets/service-account.json
GOOGLE_DOC_IDS=doc-id-1,doc-id-2
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
NVIDIA_API_KEY=change-me
NEMOTRON_EMBED_URL=https://integrate.api.nvidia.com/v1
VECTOR_DIMS=2048
TOP_K=8
RERANK_TOP_N=5
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=
LLM_TEMPERATURE=0.2
CACHE_SIM_THRESHOLD=0.8
HISTORY_MAX_TURNS=20
# Required only when LLM_PROVIDER=openai
OPENAI_API_KEY=change-me-or-omit
